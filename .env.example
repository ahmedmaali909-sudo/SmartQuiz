# ---------------------------------------------------------------------------
# SmartQuiz — variables d'environnement
# Copiez ce fichier en `.env.local` (jamais commité) et remplissez les valeurs.
# ---------------------------------------------------------------------------

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — service role (SERVER ONLY, jamais préfixé NEXT_PUBLIC_)
# Utilisé uniquement par les endpoints serveur / jobs d'administration.
SUPABASE_SERVICE_ROLE_KEY=

# Origine publique de l'application (OAuth + emails de confirmation)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Génération de questions par IA (Phase 7) — clé strictement serveur
# AI_PROVIDER : openai | groq | openrouter | mistral | deepseek | together | gemini
#   - c'est juste un raccourci qui choisit l'URL de base de l'API ; il ne contient
#     ni la clé ni le nom du modèle.
#   - laissez vide et renseignez AI_BASE_URL pour tout autre endpoint compatible OpenAI.
# AI_API_KEY et AI_MODEL acceptent des LISTES séparées par des virgules :
#   chaque couple modèle/clé est essayé dans l'ordre jusqu'à une réponse valide.
#   Exemple : AI_MODEL=gemini-flash-lite-latest,gemini-flash-latest
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# Jeton du endpoint POST /api/admin/generate (en-tête x-admin-secret)
ADMIN_SECRET=
